            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "最老事件等待年龄",
      "description": "条数看不出的东西都在这里：堆积 50 条以内曲线是平的，但最老一条可能已经等了很久 —— 那才是用户可感知的通知延迟。空批时为 0。",
      "id": 24,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 75 },
      "datasource": { "type": "prometheus", "uid": "dianping-prom" },
      "targets": [
