      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 30, "lineWidth": 1 } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "距上次扫描",
      "description": "扫描间隔 1s。持续接近抓取间隔（15s）说明抓取本身在漂；这个数一直涨而 pending 也涨，说明调度线程根本没在跑（@Scheduled 与 ES/Redis 补偿共用调度池），只看 pending 分不出来。",
      "id": 25,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 75 },
      "datasource": { "type": "prometheus", "uid": "dianping-prom" },
